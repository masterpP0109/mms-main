# Neon pooled URL for server-side Prisma queries (populated by neon deploy).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require&sslaccept=strict"
# Direct URL for Prisma migrations; the CLI falls back to DATABASE_URL for other Postgres hosts.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&sslaccept=strict"

# Titan SMTP (server-only; never prefix with NEXT_PUBLIC_).
# Set SMTP_HOST=smtp.titan.email and SMTP_PORT=465 in your local environment.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL_TO=

# Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN="replace_me"
WHATSAPP_PHONE_NUMBER_ID="replace_me"
WHATSAPP_BUSINESS_ACCOUNT_ID="replace_me"
WHATSAPP_APP_SECRET="replace_me"
WHATSAPP_VERIFY_TOKEN="generate_a_long_random_value"
WHATSAPP_NOTIFICATION_TO="263788111391"
WHATSAPP_NOTIFICATION_TEMPLATE="new_lead_notification"
WHATSAPP_API_VERSION="v23.0"

# Authenticated scheduler. Generate at least 32 random characters, keep server-side.
CRON_SECRET=

# Canonical production origin; set explicitly before launch.
SITE_URL=https://mms-main.vercel.app
# Owner-approved retention period. CLI defaults to dry run.
RETENTION_DAYS=
# Local/CI isolated integration database; never use production.
MMS_TEST_DATABASE_URL=
