# PostgreSQL connection string used by Prisma. Use a separate database for each environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Resend API (server-only; never prefix with NEXT_PUBLIC_).
RESEND_API_KEY=
MMS_NOTIFICATION_EMAIL=info@mosimediasolutions.com
MMS_FROM_EMAIL=

