# PostgreSQL connection string used by Prisma. Use a separate database for each environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Resend API (server-only; never prefix with NEXT_PUBLIC_).
RESEND_API_KEY=
MMS_NOTIFICATION_EMAIL=info@mosimediasolutions.com
MMS_FROM_EMAIL=

# Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN="replace_me"
WHATSAPP_PHONE_NUMBER_ID="replace_me"
WHATSAPP_BUSINESS_ACCOUNT_ID="replace_me"
WHATSAPP_APP_SECRET="replace_me"
WHATSAPP_VERIFY_TOKEN="generate_a_long_random_value"
WHATSAPP_NOTIFICATION_TO="263788111391"
WHATSAPP_NOTIFICATION_TEMPLATE="new_lead_notification"
WHATSAPP_API_VERSION="v23.0"

# Authenticated scheduler. Generate at least 32 random characters, keep server-side.
CRON_SECRET=

# Canonical production origin; set explicitly before launch.
SITE_URL=https://mms-main.vercel.app
# Owner-approved retention period. CLI defaults to dry run.
RETENTION_DAYS=
# Local/CI isolated integration database; never use production.
MMS_TEST_DATABASE_URL=
