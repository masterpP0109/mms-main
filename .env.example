# PostgreSQL connection string used by Prisma. Use a separate database for each environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mms?schema=public"

# Resend transactional email (server-only secrets; never prefix with NEXT_PUBLIC_).
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="MMS Website <website@your-verified-domain.example>"
LEAD_NOTIFICATION_EMAIL="info@example.com"

# Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN="replace_me"
WHATSAPP_PHONE_NUMBER_ID="replace_me"
WHATSAPP_BUSINESS_ACCOUNT_ID="replace_me"
WHATSAPP_APP_SECRET="replace_me"
WHATSAPP_VERIFY_TOKEN="generate_a_long_random_value"
WHATSAPP_NOTIFICATION_TO="2637XXXXXXXX"
WHATSAPP_NOTIFICATION_TEMPLATE="new_lead_notification"
WHATSAPP_API_VERSION="v23.0"
